<?xml version="1.0" encoding="utf-16"?>
<kml:kml xmlns:kml="http://www.opengis.net/kml/2.2">
  <kml:Document>
    <kml:name>styles.kml</kml:name>
    <!-- Styles -->
    <kml:Style id="Submitted">
      <kml:IconStyle>
        <kml:Icon></kml:Icon>
      </kml:IconStyle>
      <kml:LabelStyle>
        <kml:scale>0</kml:scale>
      </kml:LabelStyle>
      <kml:LineStyle>
        <kml:color>ffffffff</kml:color>
        <kml:width>3</kml:width>
      </kml:LineStyle>
      <kml:PolyStyle>
        <kml:color>4800ff00</kml:color>
      </kml:PolyStyle>
    </kml:Style>
    <kml:Style id="Submitted_hlt">
      <kml:IconStyle>
        <kml:Icon></kml:Icon>
      </kml:IconStyle>
      <kml:LineStyle>
        <kml:color>ff0000ff</kml:color>
        <kml:width>4</kml:width>
      </kml:LineStyle>
      <kml:PolyStyle>
        <kml:color>4800ff00</kml:color>
      </kml:PolyStyle>
    </kml:Style>
    <kml:StyleMap id="Submitted_rollover">
      <kml:Pair>
        <kml:key>normal</kml:key>
        <kml:styleUrl>#Submitted</kml:styleUrl>
      </kml:Pair>
      <kml:Pair>
        <kml:key>highlight</kml:key>
        <kml:styleUrl>#Submitted_hlt</kml:styleUrl>
      </kml:Pair>
    </kml:StyleMap>
  </kml:Document>
</kml:kml>
